<UserControl x:Class="TestFileWatcher.Controls.IconViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TestFileWatcher.Controls"
             mc:Ignorable="d" 
             Width="32" Height="32">
    <Grid>
        <Image Source="{Binding Path=ImageSource, RelativeSource={RelativeSource FindAncestor, AncestorType=local:IconViewer}}"/>
    </Grid>
</UserControl>
